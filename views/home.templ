package views

templ Home(title string, message string) {
        <!DOCTYPE html>
        <html lang="en">
                <head>
                        <meta charset="utf-8" />
                        <meta name="viewport" content="width=device-width, initial-scale=1" />
                        <title>{ title }</title>
                </head>
                <body>
                        <main>
                                <h1>{ message }</h1>
                        </main>
                </body>
        </html>
}
