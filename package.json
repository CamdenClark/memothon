{
  "name": "memothon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:push": "dotenvx run --env-file=.dev.vars -- drizzle-kit push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.3.27",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.11"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.27",
    "@cloudflare/vite-plugin": "^1.2.3",
    "@dotenvx/dotenvx": "^1.51.0",
    "drizzle-kit": "^0.31.5",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "wrangler": "^4.17.0"
  }
}