{
  "name": "memothon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:push": "dotenvx run --env-file=.dev.vars -- drizzle-kit push",
    "auth:generate": "dotenvx run --env-file=.dev.vars -- bunx cli generate --config src/auth.ts --output src/db/auth-schema.ts -y",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.3.27",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.11",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.27",
    "@cloudflare/vite-plugin": "^1.2.3",
    "@dotenvx/dotenvx": "^1.51.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/ui": "^4.0.6",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "vitest": "^4.0.6",
    "wrangler": "^4.17.0"
  }
}
